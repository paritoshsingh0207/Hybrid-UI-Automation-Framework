<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="OrangeHRM Secure Sample Suite" verbose="1">
    <listeners>
        <listener class-name="com.hybrid.framework.listeners.SuiteConfigurationListener"/>
        <listener class-name="com.hybrid.framework.listeners.RetryTransformer"/>
        <listener class-name="com.hybrid.framework.listeners.TestExecutionListener"/>
        <listener class-name="com.hybrid.framework.listeners.ReportLifecycleListener"/>
    </listeners>

    <!--
        This suite is separate from testng.xml on purpose.
        It needs credentials supplied at runtime, so the normal demo suite can
        still run on a fresh clone without any secret configuration.
    -->
    <test name="Feature Data Tests - OrangeHRM Secure Sample">
        <classes>
            <class name="com.hybrid.tests.orangehrm.runners.OrangeHrmCucumberTestRunner"/>
        </classes>
    </test>
</suite>
